# Backup upload endpoint
GUIDE_UPLOAD_URL=https://www.jingcc.cc/api/guides/upload
GUIDE_UPLOAD_FIELD_NAME=file

# Choose one auth method that matches the server
# GUIDE_UPLOAD_COOKIE=
# GUIDE_UPLOAD_TOKEN=

# Optional custom auth header pair
# GUIDE_UPLOAD_AUTH_HEADER=
# GUIDE_UPLOAD_AUTH_VALUE=

# true: create zip only, do not upload
GUIDE_UPLOAD_DRY_RUN=true
